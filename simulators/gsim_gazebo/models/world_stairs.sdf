<?xml version="1.0"?>
<!--
  world_flat.sdf plus Ghost's staircase from its Bullet world, built from the same boxes as
  simulators/gsim_mujoco/models/scene_stairs.xml: 6 steps of about 0.22 m rise and 0.30 m run, 2 m
  wide, the first edge at x = 2.851 m in front of the start pose, the landing top at 1.305 m; the
  ground is 100 m x 100 m. Select with:
    scripts/run_sim.sh gsim_backend gazebo gsim_world simulators/gsim_gazebo/models/world_stairs.sdf
  ghost_sim inserts the robot model before the closing world tag. Keep max_step_size at 0.0005 and
  real_time_update_rate at 0 (see world_flat.sdf).
-->
<sdf version="1.9">
  <world name="ghost_sim">
    <physics name="2khz" type="dart">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
      <dart>
        <!-- Gazebo's default; explicit so DART never picks the Bullet detector (ghost_sim also
             carries the SDK's own Bullet). -->
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <!-- DART uses the smaller friction of a contact pair: a large value here lets each robot
               part's own friction apply (the toes' gsim_toe_friction), as MuJoCo's max rule does. -->
          <surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.55 0.6 0.65 1</ambient>
            <diffuse>0.55 0.6 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name='stairs'>
      <static>true</static>
      <link name='link'>
        <collision name='step1_c'><pose>3.744 0 0.102 0 0 0</pose><geometry><box><size>1.7860 2.0060 0.2040</size></box></geometry></collision>
        <visual name='step1_v'><pose>3.744 0 0.102 0 0 0</pose><geometry><box><size>1.7860 2.0060 0.2040</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='step2_c'><pose>3.893 0 0.2125 0 0 0</pose><geometry><box><size>1.4880 2.0060 0.4250</size></box></geometry></collision>
        <visual name='step2_v'><pose>3.893 0 0.2125 0 0 0</pose><geometry><box><size>1.4880 2.0060 0.4250</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='step3_c'><pose>4.0415 0 0.3225 0 0 0</pose><geometry><box><size>1.1910 2.0060 0.6450</size></box></geometry></collision>
        <visual name='step3_v'><pose>4.0415 0 0.3225 0 0 0</pose><geometry><box><size>1.1910 2.0060 0.6450</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='step4_c'><pose>4.1905 0 0.433 0 0 0</pose><geometry><box><size>0.8930 2.0060 0.8660</size></box></geometry></collision>
        <visual name='step4_v'><pose>4.1905 0 0.433 0 0 0</pose><geometry><box><size>0.8930 2.0060 0.8660</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='step5_c'><pose>4.3395 0 0.5435 0 0 0</pose><geometry><box><size>0.5950 2.0060 1.0870</size></box></geometry></collision>
        <visual name='step5_v'><pose>4.3395 0 0.5435 0 0 0</pose><geometry><box><size>0.5950 2.0060 1.0870</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='step6_c'><pose>4.488 0 0.6535 0 0 0</pose><geometry><box><size>0.2980 2.0060 1.3070</size></box></geometry></collision>
        <visual name='step6_v'><pose>4.488 0 0.6535 0 0 0</pose><geometry><box><size>0.2980 2.0060 1.3070</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <collision name='landing_c'><pose>6.0 0 0.0 0 0 0</pose><geometry><box><size>3.0000 2.0000 2.6100</size></box></geometry></collision>
        <visual name='landing_v'><pose>6.0 0 0.0 0 0 0</pose><geometry><box><size>3.0000 2.0000 2.6100</size></box></geometry><material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>
  </world>
</sdf>
