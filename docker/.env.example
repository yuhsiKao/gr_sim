# Per-machine settings. Copy to docker/.env (not committed) and edit.

# The Ghost SDK: the GhostSDK_bullet_linux directory of GhostSDK 1.0.1 (it contains lib/libgrcontrols.a).
# The container mounts it read-only; scripts/env.sh reads it too when building without Docker.
CONTROLS_INSTALL_DIR=/path/to/GhostSDK_1.0.1/GhostSDK_bullet_linux
